datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                          String            @id @default(cuid())
  email                       String            @unique
  passwordHash                String
  firstName                   String
  lastName                    String
  avatarUrl                   String?
  systemRole                  String            @default("USER") // USER, SUPER_ADMIN
  status                      String            @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  lastActiveAt                DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  workspaces                  WorkspaceMember[]
  posts                       ContentPost[]
  createdPlanOverrides        PlanOverride[]    @relation("PlanOverrideAdmin")
  createdUsageCredits         UsageCredit[]     @relation("UsageCreditAdmin")
  createdPaymentTransactions  PaymentTransaction[] @relation("PaymentTransactionAdmin")
}

model Workspace {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  timezone       String            @default("Asia/Karachi")
  plan           String            @default("FREE") // FREE, STARTER, PRO, AGENCY
  status         String            @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  suspendedAt    DateTime?
  suspendedReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  members        WorkspaceMember[]
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  posts          ContentPost[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  subscriptions  Subscription[]
  planOverrides  PlanOverride[]
  usagePeriods   UsagePeriod[]
  usageCredits   UsageCredit[]
  paymentTransactions PaymentTransaction[]
}

model Plan {
  id                       String      @id
  code                     String      @unique // FREE, STARTER, PRO, AGENCY
  name                     String
  description              String
  monthlyPrice             Int         @default(0) // Minor units, e.g. cents or paisa
  yearlyPrice              Int         @default(0)
  currency                 String      @default("USD")
  maxSocialAccounts        Int
  monthlyPostLimit         Int
  maxTeamMembers           Int
  storageLimitMB           Int
  bulkUploadEnabled        Boolean     @default(false)
  analyticsEnabled         Boolean     @default(true)
  advancedAnalyticsEnabled Boolean     @default(false)
  schedulingEnabled        Boolean     @default(true)
  customCaptionsEnabled    Boolean     @default(true)
  prioritySupportEnabled   Boolean     @default(false)
  active                   Boolean     @default(true)
  sortOrder                Int         @default(0)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  subscriptions            Subscription[]
  planOverrides            PlanOverride[]
  paymentTransactions      PaymentTransaction[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER") // OWNER, ADMIN, EDITOR, VIEWER
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model SocialAccount {
  id                String         @id @default(cuid())
  workspaceId       String
  platform          String         // INSTAGRAM, FACEBOOK, TIKTOK, LINKEDIN, YOUTUBE, X, PINTEREST, SNAPCHAT
  platformAccountId String
  name              String
  username          String
  profileImageUrl   String?
  status            String         @default("CONNECTED") // CONNECTED, DISCONNECTED, EXPIRED, NEEDS_RECONNECTION
  isMock            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token             OAuthToken?
  platformPosts     PlatformPost[]

  @@unique([workspaceId, platform, platformAccountId])
}

model OAuthToken {
  id              String        @id @default(cuid())
  socialAccountId String        @unique
  accessToken     String
  refreshToken    String?
  scope           String?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

model MetaOAuthState {
  id          String    @id @default(cuid())
  stateHash   String    @unique
  userId      String
  workspaceId String
  redirectUri String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  @@index([userId, workspaceId])
  @@index([expiresAt])
}

model MetaOAuthSelection {
  id                 String    @id @default(cuid())
  selectionTokenHash String    @unique
  userId             String
  workspaceId        String
  accountsJson       String
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  consumedAt         DateTime?

  @@index([userId, workspaceId])
  @@index([expiresAt])
}

model TikTokOAuthState {
  id           String    @id @default(cuid())
  stateHash    String    @unique
  codeVerifier String
  userId       String
  workspaceId  String
  redirectUri  String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
}

model MediaAsset {
  id           String        @id @default(cuid())
  workspaceId  String
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  width        Int?
  height       Int?
  duration     Float?
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts        ContentPost[]
}

model ContentPost {
  id            String         @id @default(cuid())
  workspaceId   String
  userId        String
  title         String?
  masterCaption String
  status        String         @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED, PARTIALLY_FAILED, FAILED, CANCELLED
  scheduledFor  DateTime?
  publishedAt   DateTime?
  timezone      String         @default("Asia/Karachi")
  mediaAssetId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])
  mediaAsset    MediaAsset?    @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  platformPosts PlatformPost[]
}

model PlatformPost {
  id             String          @id @default(cuid())
  contentPostId  String
  socialAccountId String
  platform       String          // INSTAGRAM, FACEBOOK, TIKTOK, LINKEDIN, YOUTUBE, X, PINTEREST, SNAPCHAT
  customCaption  String?
  hashtags       String?
  contentType    String?         // POST, REEL, VIDEO, SHORT, CAROUSEL
  visibility     String?         // PUBLIC, PRIVATE, UNLISTED
  metadata       String?         // JSON string for platform-specific flags (comments, duet, title, etc)
  status         String          @default("DRAFT") // DRAFT, QUEUED, PROCESSING, UPLOADING, SCHEDULED, PUBLISHED, FAILED, RETRYING, CANCELLED
  externalPostId String?
  externalPostUrl String?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  contentPost    ContentPost     @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  socialAccount  SocialAccount   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  publishingJobs PublishingJob[]
}

model PublishingJob {
  id              String              @id @default(cuid())
  platformPostId  String
  status          String              @default("QUEUED") // QUEUED, PROCESSING, UPLOADING, PUBLISHED, FAILED, RETRYING, CANCELLED
  attempts        Int                 @default(0)
  maxAttempts     Int                 @default(3)
  scheduledAt     DateTime            @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  platformPost    PlatformPost        @relation(fields: [platformPostId], references: [id], onDelete: Cascade)
  attemptsHistory PublishingAttempt[]
}

model PublishingAttempt {
  id              String        @id @default(cuid())
  publishingJobId String
  status          String
  responseCode    Int?
  responseBody    String?
  errorMessage    String?
  attemptedAt     DateTime      @default(now())
  publishingJob   PublishingJob @relation(fields: [publishingJobId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  title       String
  message     String
  type        String    @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  isRead      Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id            String     @id @default(cuid())
  workspaceId   String?
  userId        String?
  actorUserId   String?
  targetUserId  String?
  action        String
  details       String?
  metadata      String?
  createdAt     DateTime   @default(now())
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

model Subscription {
  id                     String    @id @default(cuid())
  workspaceId            String
  planId                 String?
  planTier               String    @default("FREE") // Legacy/display cache: FREE, STARTER, PRO, AGENCY
  status                 String    @default("ACTIVE") // TRIALING, ACTIVE, PAST_DUE, CANCELED, EXPIRED, MANUAL
  source                 String    @default("MANUAL") // MANUAL, SAFE_PAY, STRIPE, OTHER
  startedAt              DateTime  @default(now())
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  trialEndsAt            DateTime?
  externalCustomerId     String?
  externalSubscriptionId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                   Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([planId])
}

model PlanOverride {
  id               String    @id @default(cuid())
  workspaceId      String
  planId           String
  reason           String
  startsAt         DateTime  @default(now())
  expiresAt        DateTime?
  lifetime         Boolean   @default(false)
  createdByAdminId String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan             Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdByAdmin   User?     @relation("PlanOverrideAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([workspaceId, revokedAt, expiresAt])
  @@index([planId])
}

model UsagePeriod {
  id              String    @id @default(cuid())
  workspaceId     String
  periodStart     DateTime
  periodEnd       DateTime
  publishedPosts  Int       @default(0)
  scheduledPosts  Int       @default(0)
  uploadedBytes   BigInt    @default(0)
  bulkUploadCount Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart, periodEnd])
  @@index([workspaceId, periodStart])
}

model UsageCredit {
  id               String    @id @default(cuid())
  workspaceId      String
  type             String    // POSTS, STORAGE_MB, SOCIAL_ACCOUNTS, TEAM_MEMBERS
  amount           Int
  reason           String
  startsAt         DateTime  @default(now())
  expiresAt        DateTime?
  createdByAdminId String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByAdmin   User?     @relation("UsageCreditAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type, revokedAt, expiresAt])
}

model PaymentTransaction {
  id               String    @id @default(cuid())
  workspaceId      String
  planId           String?
  amount           Int
  currency         String    @default("USD")
  provider         String    // SAFE_PAY, BANK_TRANSFER, RAAST, CASH, STRIPE, OTHER
  reference        String?
  status           String    @default("PAID") // PENDING, PAID, FAILED, REFUNDED
  paidAt           DateTime?
  notes            String?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan             Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdByAdmin   User?     @relation("PaymentTransactionAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([planId])
}
