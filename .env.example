# ==============================================
# SOCIAL MEDIA OS - ENVIRONMENT CONFIGURATION
# ==============================================

# Application URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Mode: "true" to simulate platform publishing without live API credentials
MOCK_API_MODE="true"
REAL_API_MODE="false"

# Database Connection (SQLite default for instant local run; use postgresql://... for PostgreSQL)
DATABASE_URL="file:./dev.db"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
AUTH_SECRET="social-media-os-dev-super-secure-session-secret-key-32chars"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef" # 32 bytes for AES-256

# Optional Queue / Background Worker (Redis / BullMQ)
REDIS_URL=""

# Storage Configuration ("local" or "s3")
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"
# AWS / Cloudflare R2 S3 Settings (Optional when STORAGE_PROVIDER="s3")
# S3_BUCKET_NAME=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# ==============================================
# SOCIAL PLATFORM DEVELOPER CREDENTIALS (PHASE 2+)
# ==============================================

# Meta / Instagram Graph API & Facebook Pages API
# Portal: https://developers.facebook.com
META_APP_ID=""
META_APP_SECRET=""
META_LOGIN_CONFIG_ID=""
META_REDIRECT_URI="http://localhost:3000/api/oauth/meta/callback"

# TikTok Content Posting API
# Portal: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Google / YouTube Data API v3
# Portal: https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LinkedIn Community Management API
# Portal: https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# X (Twitter) Developer API v2
# Portal: https://developer.x.com
X_CLIENT_ID=""
X_CLIENT_SECRET=""
